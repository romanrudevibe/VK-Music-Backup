{
  "manifest_version": 3,
  "name": "Мои аудиозаписи — резервная копия",
  "version": "0.1.19",
  "minimum_chrome_version": "120",
  "description": "Сохранение добавленных аудиозаписей VK с очередью и восстановлением прогресса.",
  "permissions": [
    "downloads",
    "scripting",
    "offscreen",
    "alarms",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://vk.com/*",
    "https://vk.ru/*",
    "https://m.vk.com/*",
    "https://m.vk.ru/*",
    "https://*.vkuseraudio.net/*",
    "https://*.vkuseraudio.com/*",
    "https://*.useraudio.net/*",
    "https://*.useraudio.com/*",
    "https://*.vkuservideo.net/*",
    "https://*.vk-cdn.net/*",
    "https://*.vkuseraudio.ru/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Открыть очередь аудиозаписей"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
